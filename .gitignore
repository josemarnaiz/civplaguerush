# Godot 4+ specific ignores
.godot/
.import/
export.cfg
*.translation
*.mo

# Build artifacts
build/
exports/
# Keep the .godotignore marker so Godot never scans build/ for imports.
!build/.godotignore

# Runtime logs
run_log.txt
run_log.txt.err
*.log

# Generated screenshots and captures
.cursor/*.png
.cursor/*.log
.cursor/last_run.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
*.swp
*.swo
*~

# Python tooling (art generators)
__pycache__/
*.pyc

# Orphan copies occasionally created by tooling at the project root.
# The canonical file lives at scripts/mcp_interaction_server.gd.
/mcp_interaction_server.gd
/mcp_interaction_server.gd.uid
